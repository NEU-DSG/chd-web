<footer>
  <div class="lang-switch--footer">
    {% include "langswitcher.njk" %}
  </div>
</footer>

<script>
  (function () {
    // Keep any query string on every language link — header dropdown AND footer
    var query = window.location.search;
    if (query) {
      document.querySelectorAll("a.lang-switch").forEach(function (link) {
        link.href += query;
      });
    }

    // Header language dropdown
    var dd = document.querySelector(".lang-dropdown");
    if (dd) {
      var btn = dd.querySelector(".lang-dropdown__button");
      var menu = dd.querySelector(".lang-dropdown__menu");

      function setOpen(open) {
        menu.hidden = !open;
        btn.setAttribute("aria-expanded", String(open));
      }

      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        setOpen(menu.hidden);
      });
      document.addEventListener("click", function (e) {
        if (!dd.contains(e.target)) setOpen(false);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });
    }
  })();
</script>