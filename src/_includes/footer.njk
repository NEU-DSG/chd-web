<footer>
  <div class="lang-switch--footer">
    {% include "langswitcher.njk" %}
  </div>
</footer>

<script>
// immediately initialize
(() => {
  // Keep any query string on every language link — header dropdown AND footer
  const query = window.location.search;

  if (query) {
    document.querySelectorAll("a.lang-switch").forEach(link => {
      const url = new URL(link.href, window.location.origin);
      url.search = query;
      link.href = url.toString();
    });
  }

  // Header language dropdown
  // check if dropdown exists
  const dropdown = document.querySelector(".lang-dropdown");
  if (!dropdown) return;

  // grab items
  const button = dropdown.querySelector(".lang-dropdown__button");
  const menu = dropdown.querySelector(".lang-dropdown__menu");

  // function for opening and closing menu
  function setOpen(open) {
  menu.hidden = !open;
  button.setAttribute("aria-expanded", open);
  }

  // listen for click
  button.addEventListener("click", event => {
    event.stopPropagation();
    setOpen(menu.hidden);
  });

  // listen for click away
  document.addEventListener("click", event => {
    if (!dropdown.contains(event.target)) {
      setOpen(false);
    }
  });

  // listen for keydown
  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      setOpen(false);
    }
  });
})();
</script>