{% set locales = ["en", "zh-Hans", "zh-Hant"] %}
{% set labels = { "en": "English", "zh-Hans": "简体中文", "zh-Hant": "繁體中文" } %}

<span class="lang-available">{{ languages[page.lang].availableText }}</span>

<nav class="lang-nav" aria-label="{{ languages[page.lang].ariaLang }}">
  {% for lang in locales %}
    {% if lang != page.lang %}
    <a
      class="lang-switch"
      href="{{ page.url | locale_swap(lang) }}"
      lang="{{ lang }}"
      hreflang="{{ lang }}"
      >{{ labels[lang] }}</a
    >
    {% endif %}
  {% endfor %}
</nav>