<header>
  <nav aria-label="{{ languages[page.lang].ariaPrimary }}">
    <ul>
      {%- for item in navigation[page.lang] %}
      <li{% if item.children %} class="has-dropdown"{% endif %}>
        <a href="{{ item.url }}" {{ helpers.getLinkActiveState(item.url, page.url) | safe }}>{{ item.text }}</a>

        {%- if item.children %}
        <ul class="dropdown">
          {%- for child in item.children %}
          <li>
            <a href="{{ child.url }}" {{ helpers.getLinkActiveState(child.url, page.url) | safe }}>{{ child.text }}</a>
          </li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </nav>
</header>